# Update and cp env.example .env

# MongoDB Configuration
# Local dev (API on host): use localhost
# Docker (API in container): use host.docker.internal to reach MongoDB on the host
MONGODB_URI=mongodb://username:password@localhost:27017/?authSource=admin&directConnection=true
MONGODB_DB=pensive

# LLM Configuration
# AI gateway OpenAI Responses API endpoint (Pensive prefers the Responses API
# to work correctly with reasoning models). Set the full endpoint (ending in
# /responses), a Chat Completions URI (ending in /chat/completions), or just
# the base .../v1 and Pensive appends it. Models that reject the Responses
# protocol with `model_not_found` (e.g. deepseek-*, glm-*) are retried
# automatically against /chat/completions.
LLM_URI=https://ai-gateway.corp.mongodb.com/openai/v1/chat/completions
LLM_MODEL=gpt-5.6-luna
# Sent as `Authorization: Bearer <LLM_KEY>`.
LLM_KEY=YOURKEY

# Embedding Configuration
LLM_EMBEDDING_URI=https://ai.mongodb.com/v1/embeddings
LLM_EMBEDDING_MODEL=voyage-4-lite
LLM_EMBEDDING_KEY=YOURKEY
# Used for creating vector indexes
EMBEDDING_DIMENSIONS=1024

# Contextualized chunk embeddings (document ingestion). Same key as the
# embeddings above; override the URI/model for a different Voyage surface.
# CONTEXT_EMBEDDING_URI=https://ai.mongodb.com/v1/contextualizedembeddings
# CONTEXT_EMBEDDING_MODEL=voyage-context-4
# Directory that keeps uploaded document originals (bind-mounted in docker).
# DOCUMENTS_DIR=document-uploads

# Optional: enables Voyage reranking of retrieved memories. Leave empty to rank
# by vector similarity only (no rerank).
# VOYAGE_API_KEY=

# --- Atlas Agent Engine memory (agent-engine-sdk-memory) ---
# Pensive's long-term memory IS the Agent Engine memory service. docker-compose
# runs that service (memory-server + memory-oe) against Pensive's OWN MongoDB
# (MONGODB_URI above) — one database instance, no external Agent Engine stack.
# The compose default points Pensive at it: http://memory-oe:8000
# A host-run Pensive (uvicorn main:app) can use http://localhost:8010 instead.
# To use the hosted platform instead, set a project id + service-account token.
# AGENTIC_MEMORY_BASE_URL=http://localhost:8010
# AGENTIC_MEMORY_PROJECT_ID=
# AGENTIC_MEMORY_SERVICE_ACCOUNT_TOKEN=
# Gross context budget for the memory block injected into the prompt.
# AGENTIC_MEMORY_MAX_TOKENS=2048

# Memory service identity (the docker-compose defaults are fine for local use).
# The memory server keeps its collections in database PENSIVE_MEMORY_DB on the
# MongoDB above; PENSIVE_PROJECT_ID scopes them to this project.
# PENSIVE_ORG_ID=000000000000000000000001
# PENSIVE_PROJECT_ID=70656e736976650000000001
# PENSIVE_APP_ID=70656e736976650000000002
# PENSIVE_MEMORY_DB=pensive_memory

# Optional fallback for curl/local testing without OpenWebUI session headers
# Identity pin: when set, ALL clients share this memory scope (wins over
# forwarded OpenWebUI user headers and body user). Leave empty to scope
# memory per forwarded user.
# USER_ID=default

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=YOURKEY
LANGSMITH_PROJECT="pensive"
# Agent lab: where test-agent file workspaces are created (per agent id).
# Default when unset: <repo>/agent-workspaces — keep agent builds inside the
# project directory, never in home-dir caches.
PENSIVE_AGENT_WORKSPACES=./agent-workspaces

# Host projects directory mounted read-only into the container at /projects
# (default: $HOME/projects — includes the OKF bundle). Pensive agents can
# project_list / project_read files here. Set the host dir with PROJECTS_HOST_DIR
# in the shell before `docker compose up`.
# PENSIVE_PROJECTS_ROOT=/projects

# --- Glean MCP (enterprise search) ---
# The MCP scope is required by Glean's MCP server (search/document retrieval).
# GLEAN_MCP_URL=https://mongodb-be.glean.com/mcp/default
# GLEAN_SCOPE=SEARCH DOCUMENTS ENTITIES MCP
# GLEAN_REDIRECT_URI=http://localhost:8000/glean/callback
# The token cache (./glean-tokens.json) is bind-mounted into the container;
# run `python scripts/glean_auth.py` once (or use the console Connect button)
# to authenticate as the local user.
